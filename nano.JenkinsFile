pipeline {
    agent any

    tools {
        nodejs 'node18'
    }

    stages {

        stage('Get Code from GitHub') {
            steps {
                git url: 'https://github.com/ArunKr2/Playwright--E2E--JS'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
                sh 'npx playwright install'
            }
        }

        stage('Run Playwright Tests') {
            steps {
                sh 'npm test'
            }
        }
    }
}
